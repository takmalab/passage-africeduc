# Copier ce fichier en .env puis adapter. Ne jamais versionner .env.
# Aucune valeur ci-dessous n'est un vrai secret.

# --- Serveur ---
NODE_ENV=development
PORT=3000
# Origine publique de l'application (sert au contrôle anti-CSRF de l'en-tête Origin).
APP_ORIGIN=http://localhost:3000
# Mettre true derrière un proxy (Render, Railway...) pour lire la vraie IP du client.
TRUST_PROXY=false
# HTTPS local optionnel (réseau Wi-Fi, téléphone de démo) : chemins vers un certificat.
# Générer avec : npm run cert:lan  (voir docs/DEPLOIEMENT.md)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_PORT=8443

# --- Base de données ---
# En local avec docker compose : postgresql://passage:passage@localhost:5432/passage
DATABASE_URL=postgresql://passage:CHANGE_ME@localhost:5432/passage
# Base dédiée aux tests d'intégration (vidée à chaque exécution).
TEST_DATABASE_URL=postgresql://passage:CHANGE_ME@localhost:5432/passage_test

# --- Sessions et connexion ---
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Badges (cartes NFC NTAG 424 DNA) ---
# Clé maîtresse dont dérivent les clés AES des cartes : 64 caractères hexadécimaux.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La changer invalide toutes les cartes déjà programmées.
BADGE_KEYS_MASTER_KEY=
# Tolérance (minutes) sur l'ordre des compteurs NFC entre appareils synchronisés en décalé.
NFC_ORDER_TOLERANCE_MINUTES=2
# Simulateur de carte NFC (démonstration sans matériel). Mettre false en production réelle.
CARD_SIMULATOR_ENABLED=true

# --- Horloge des appareils ---
CLOCK_SKEW_FLAG_SECONDS=120
CLOCK_MAX_AGE_HOURS=72

# --- Anomalies ---
DOUBLE_SCAN_SECONDS=60
# Délai après la fin d'une fenêtre avant de déclarer un passage manquant
# (laisse le temps aux scans hors ligne d'arriver).
WINDOW_GRACE_MINUTES=15
# Fenêtre de détection d'une carte imprimée utilisée sur deux appareils (clone).
PRINTED_CLONE_MINUTES=5
# Carte QR imprimée : une seule validation par point de contrôle dans cette fenêtre.
PRINTED_REUSE_MINUTES=120
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- Notifications ---
NOTIFY_MAX_PER_STUDENT_PER_DAY=3
# outbox = table + journal seulement (aucun envoi réel)
NOTIFY_PROVIDER=outbox

# --- IA (synthèse du jour) ---
# Toute API au format « chat/completions » (DECISIONS.md, D17). Par défaut : Groq,
# offre gratuite (clé sur https://console.groq.com). Exemple Mistral (payant) :
#   AI_BASE_URL=https://api.mistral.ai/v1  AI_MODEL=mistral-small-latest
# Laisser AI_API_KEY vide pour le mode dégradé : la synthèse est produite par gabarit.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=8000
# Large : gpt-oss « réfléchit » avant de répondre, et cette réflexion compte.
AI_MAX_OUTPUT_TOKENS=1000
# Plafond de dépense par jour (USD). Au-delà, appels bloqués et gabarit utilisé.
AI_DAILY_BUDGET_USD=0.50
# Tarifs indicatifs (USD par million de tokens) pour estimer le coût, à ajuster selon le
# modèle : sert au plafond même si l'offre utilisée est gratuite.
AI_PRICE_INPUT_PER_MTOK=0.15
AI_PRICE_OUTPUT_PER_MTOK=0.60

# --- Données de démonstration ---
# Mot de passe des comptes créés par le seed (comptes de test, jamais en production réelle).
SEED_PASSWORD=Passage2026!
